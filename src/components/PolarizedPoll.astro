---
export interface Props {
  pollId?: string;
  question: string;
  optionA: {
    label: string;
    subtext?: string;
    initialVotes?: number;
  };
  optionB: {
    label: string;
    subtext?: string;
    initialVotes?: number;
  };
  hotTakeQuote?: string;
  hotTakeAuthor?: string;
}

const {
  pollId = 'default-hardware-poll',
  question,
  optionA,
  optionB,
  hotTakeQuote = 'Paying $1,599 for a single cooling fan and last-gen memory bandwidth is peak Stockholm syndrome.',
  hotTakeAuthor = '@SiliconCynic · Top Reader Comment (+412 upvotes)'
} = Astro.props;

const votesA = optionA.initialVotes ?? 1842;
const votesB = optionB.initialVotes ?? 519;
const totalInitial = votesA + votesB;
---

<section
  class="polarized-poll-widget not-prose my-6 border-2 border-[#141413] bg-[#FCFBF8] p-5 shadow-[4px_4px_0px_#141413]"
  data-poll-id={pollId}
  data-votes-a={votesA}
  data-votes-b={votesB}
>
  <div class="mb-2 flex flex-wrap items-center justify-between gap-2 border-b border-stone-300 pb-2">
    <span class="font-mono text-[11px] font-bold uppercase tracking-widest text-[#D9381E]">
      Reader Flashpoll · Above-the-Fold Verdict
    </span>
    <span class="poll-total-counter font-mono text-xs text-stone-600">
      {totalInitial.toLocaleString()} votes recorded
    </span>
  </div>

  <h3 class="font-serif text-xl font-extrabold leading-snug text-[#141413]">
    {question}
  </h3>

  <!-- Two Polarized Buttons -->
  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    <button
      type="button"
      class="poll-option-btn group relative overflow-hidden border-2 border-[#141413] bg-[#F7F4EE] p-4 text-left transition hover:bg-[#FDECE9]"
      data-choice="A"
    >
      <div
        class="poll-bar-fill pointer-events-none absolute inset-y-0 left-0 w-0 bg-[#D9381E]/20 transition-all duration-500"
      ></div>
      <div class="relative z-10 flex items-center justify-between gap-2">
        <div>
          <div class="font-mono text-xs font-extrabold uppercase text-[#141413]">
            [A] {optionA.label}
          </div>
          {
            optionA.subtext && (
              <div class="mt-1 text-xs text-stone-600">{optionA.subtext}</div>
            )
          }
        </div>
        <span
          class="poll-pct-label hidden bg-[#D9381E] px-2 py-1 font-mono text-xs font-extrabold text-white"
        >
          0%
        </span>
      </div>
    </button>

    <button
      type="button"
      class="poll-option-btn group relative overflow-hidden border-2 border-[#141413] bg-[#F7F4EE] p-4 text-left transition hover:bg-emerald-50"
      data-choice="B"
    >
      <div
        class="poll-bar-fill pointer-events-none absolute inset-y-0 left-0 w-0 bg-[#15803D]/20 transition-all duration-500"
      ></div>
      <div class="relative z-10 flex items-center justify-between gap-2">
        <div>
          <div class="font-mono text-xs font-extrabold uppercase text-[#141413]">
            [B] {optionB.label}
          </div>
          {
            optionB.subtext && (
              <div class="mt-1 text-xs text-stone-600">{optionB.subtext}</div>
            )
          }
        </div>
        <span
          class="poll-pct-label hidden bg-[#15803D] px-2 py-1 font-mono text-xs font-extrabold text-white"
        >
          0%
        </span>
      </div>
    </button>
  </div>

  <!-- Revealed Comment Drama Box after voting -->
  <div
    class="poll-drama-reveal mt-4 hidden border-t border-stone-300 bg-[#EFECE4] p-3.5 text-xs text-[#141413]"
  >
    <div class="flex items-center justify-between gap-2 font-mono text-[11px] font-bold uppercase text-[#D9381E]">
      <span>Top Reader Letter</span>
      <span class="text-[#15803D]">✓ Vote Counted</span>
    </div>
    <p class="mt-1.5 font-serif text-sm italic text-[#141413]">“{hotTakeQuote}”</p>
    <div class="mt-1 font-mono text-[11px] text-stone-600">{hotTakeAuthor}</div>
  </div>
</section>

<script>
  function initPolarizedPolls() {
    const polls = document.querySelectorAll<HTMLElement>('.polarized-poll-widget');

    polls.forEach((widget) => {
      const pollId = widget.dataset.pollId ?? 'default';
      const storageKey = `techpulse_poll_${pollId}`;
      const votesA = Number.parseInt(widget.dataset.votesA ?? '1500', 10);
      const votesB = Number.parseInt(widget.dataset.votesB ?? '500', 10);

      const buttons = widget.querySelectorAll<HTMLButtonElement>('.poll-option-btn');
      const totalCounter = widget.querySelector<HTMLElement>('.poll-total-counter');
      const dramaReveal = widget.querySelector<HTMLElement>('.poll-drama-reveal');

      const renderResults = (choice: 'A' | 'B') => {
        const finalA = choice === 'A' ? votesA + 1 : votesA;
        const finalB = choice === 'B' ? votesB + 1 : votesB;
        const total = finalA + finalB;
        const pctA = Math.round((finalA / total) * 100);
        const pctB = 100 - pctA;

        buttons.forEach((btn) => {
          const btnChoice = btn.dataset.choice;
          const pct = btnChoice === 'A' ? pctA : pctB;
          const bar = btn.querySelector<HTMLElement>('.poll-bar-fill');
          const label = btn.querySelector<HTMLElement>('.poll-pct-label');

          if (bar) bar.style.width = `${pct}%`;
          if (label) {
            label.textContent = `${pct}%`;
            label.classList.remove('hidden');
          }
        });

        if (totalCounter) {
          totalCounter.textContent = `${total.toLocaleString()} votes recorded`;
        }
        dramaReveal?.classList.remove('hidden');
      };

      const savedChoice = window.localStorage.getItem(storageKey);
      if (savedChoice === 'A' || savedChoice === 'B') {
        renderResults(savedChoice);
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const choice = btn.dataset.choice === 'A' ? 'A' : 'B';
          window.localStorage.setItem(storageKey, choice);
          renderResults(choice);
        });
      });
    });
  }

  initPolarizedPolls();
  document.addEventListener('astro:after-swap', initPolarizedPolls);
</script>
