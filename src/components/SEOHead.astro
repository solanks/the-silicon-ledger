---
export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  slug?: string;
  isArticle?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  category?: string;
  tags?: string[];
  author?: {
    name: string;
    role?: string;
    url?: string;
  };
  heroImage?: {
    src: string;
    alt: string;
    width?: number;
    height?: number;
  };
  verdictScore?: number;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  slug,
  isArticle = false,
  pubDate,
  updatedDate,
  category = 'Hardware',
  tags = [],
  author = {
    name: 'Dr. Elena Vance',
    role: 'Chief Silicon Architect',
    url: 'https://siliconledger.io/about'
  },
  heroImage,
  verdictScore
} = Astro.props;

const siteUrl = Astro.site?.origin ?? 'https://siliconledger.io';
const adsenseClientId =
  import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || 'ca-pub-6428626874238056';

// High-contrast generated OpenGraph image URL for articles
const ogImageUrl = slug
  ? `${siteUrl}/og/${slug}.png`
  : `${siteUrl}/og/default.png`;

const heroAbsoluteUrl = heroImage?.src
  ? heroImage.src.startsWith('http')
    ? heroImage.src
    : `${siteUrl}${heroImage.src}`
  : ogImageUrl;

// Construct automatic NewsArticle JSON-LD Schema for Google Discover & Top Stories
const newsArticleJsonLd = isArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl
      },
      headline: title.slice(0, 110),
      description: description,
      image: [
        {
          '@type': 'ImageObject',
          url: heroAbsoluteUrl,
          width: heroImage?.width ?? 1600,
          height: heroImage?.height ?? 900
        },
        {
          '@type': 'ImageObject',
          url: ogImageUrl,
          width: 1200,
          height: 630
        }
      ],
      datePublished: pubDate ? pubDate.toISOString() : new Date().toISOString(),
      dateModified: (updatedDate ?? pubDate ?? new Date()).toISOString(),
      articleSection: category,
      keywords: tags.join(', '),
      author: [
        {
          '@type': 'Person',
          name: author.name,
          jobTitle: author.role,
          url: `${siteUrl}/about`
        }
      ],
      publisher: {
        '@type': 'Organization',
        name: 'The Silicon Ledger',
        url: siteUrl,
        logo: {
          '@type': 'ImageObject',
          url: `${siteUrl}/og/default.png`,
          width: 1200,
          height: 630
        }
      },
      isAccessibleForFree: true,
      ...(typeof verdictScore === 'number'
        ? {
            reviewRating: {
              '@type': 'Rating',
              ratingValue: verdictScore,
              bestRating: 10,
              worstRating: 1
            }
          }
        : {})
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'The Silicon Ledger',
      url: siteUrl,
      description
    };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title} | The Silicon Ledger</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Google Search Console Ownership Verification -->
<meta
  name="google-site-verification"
  content="gM5zuGlgH4Nu05YV_rB15rfLBss2m8_8a4UoLtkvlpQ"
/>

<!-- Critical Google Discover Directives: max-image-preview:large is mandatory for large Discover cards -->
<meta
  name="robots"
  content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
/>
<meta name="googlebot" content="index, follow, max-image-preview:large" />

<!-- RSS & Google News Sitemap Feeds for Google Discover Follow feature -->
<link
  rel="alternate"
  type="application/rss+xml"
  title="The Silicon Ledger Hardware & Silicon Feed"
  href={`${siteUrl}/rss.xml`}
/>
<link
  rel="sitemap"
  type="application/xml"
  title="Sitemap"
  href={`${siteUrl}/sitemap.xml`}
/>

<!-- OpenGraph Metadata with High-Contrast Generated OG Image -->
<meta property="og:site_name" content="The Silicon Ledger" />
<meta property="og:type" content={isArticle ? 'article' : 'website'} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content={heroImage?.alt ?? `${title} — The Silicon Ledger Review`}
/>

{
  isArticle && pubDate && (
    <meta property="article:published_time" content={pubDate.toISOString()} />
  )
}
{
  isArticle && (updatedDate ?? pubDate) && (
    <meta
      property="article:modified_time"
      content={(updatedDate ?? pubDate)!.toISOString()}
    />
  )
}
{isArticle && category && <meta property="article:section" content={category} />}
{
  isArticle &&
    tags.map((tag) => <meta property="article:tag" content={tag} />)
}

<!-- Twitter / X Large Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Google AdSense Auto-Loader (Activates automatically when PUBLIC_ADSENSE_CLIENT_ID is set) -->
{
  adsenseClientId && (
    <>
      <meta name="google-adsense-account" content={adsenseClientId} />
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClientId}`}
        crossorigin="anonymous"
      />
    </>
  )
}

<!-- Automatic NewsArticle / WebSite JSON-LD Schema -->
<script
  type="application/ld+json"
  set:html={JSON.stringify(newsArticleJsonLd)}
/>
