---
import { buildAmazonAffiliateUrl } from '../config/monetization';

export interface StreetPriceEntry {
  modelName: string;
  sourceLabel: string;
  priceUsd: number;
  benchmarkMetric: number;
  metricUnit: string;
  vramOrBandwidth: string;
  isNewRelease?: boolean;
}

export interface Props {
  title?: string;
  taxLabel?: string;
  brandTaxPct: number;
  verdictCallout: string;
  entries: StreetPriceEntry[];
}

const {
  title = 'The Overpriced Index: Launch MSRP vs. Street Prices',
  taxLabel = 'Early-Adopter Markup',
  brandTaxPct = 38,
  verdictCallout = 'Last year’s Pro tier on the refurbished street delivers better price-per-performance and more memory bandwidth for less cash.',
  entries = []
} = Astro.props;

const computedEntries = entries.map((e) => {
  const costPerUnit = e.benchmarkMetric > 0 ? e.priceUsd / e.benchmarkMetric : 0;
  const amazonUrl = buildAmazonAffiliateUrl(e.modelName);
  return {
    ...e,
    costPerUnit,
    amazonUrl
  };
});

const bestCostPerUnit = Math.min(
  ...computedEntries.map((e) => e.costPerUnit || 999999)
);
---

<section
  class="not-prose my-9 overflow-hidden rounded-2xl border border-stone-300 bg-[#FCFBF8] shadow-sm"
  aria-label="The Overpriced Index Street Price Comparison"
>
  <div
    class="flex flex-wrap items-center justify-between gap-4 border-b-2 border-[#141413] bg-[#EFECE4] px-5 py-4"
  >
    <div>
      <div class="font-mono text-[10px] font-bold uppercase tracking-widest text-[#D9381E]">
        Secondary Market Value Index · Live Retail &amp; Refurbished Tracker
      </div>
      <h3 class="mt-1 font-serif text-xl font-extrabold text-[#141413]">
        {title}
      </h3>
    </div>

    <div
      class="border-2 border-[#141413] bg-[#FDECE9] px-4 py-2 text-right"
    >
      <span class="block font-mono text-[10px] font-bold uppercase tracking-wider text-[#B02A14]">
        {taxLabel}
      </span>
      <span class="font-serif text-2xl font-extrabold text-[#D9381E]">
        +{brandTaxPct}% Markup
      </span>
    </div>
  </div>

  <div class="grid divide-y-2 divide-[#141413] md:grid-cols-3 md:divide-x-2 md:divide-y-0">
    {
      computedEntries.map((entry) => {
        const isBestValue = Math.abs(entry.costPerUnit - bestCostPerUnit) < 0.0001;
        return (
          <div
            class:list={[
              'flex flex-col justify-between p-5',
              isBestValue
                ? 'bg-emerald-50/70'
                : entry.isNewRelease
                  ? 'bg-[#FDECE9]/60'
                  : 'bg-[#FCFBF8]'
            ]}
          >
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="font-mono text-[11px] font-semibold text-stone-600">
                  {entry.sourceLabel}
                </span>
                {isBestValue ? (
                  <span class="bg-[#15803D] px-2 py-0.5 font-mono text-[10px] font-bold uppercase text-white">
                    ★ Smart Buy
                  </span>
                ) : entry.isNewRelease ? (
                  <span class="bg-[#D9381E] px-2 py-0.5 font-mono text-[10px] font-bold uppercase text-white">
                    Poor Value
                  </span>
                ) : null}
              </div>

              <h4 class="mt-2 font-serif text-lg font-bold text-[#141413]">
                {entry.modelName}
              </h4>

              <div class="mt-3 flex items-baseline gap-2">
                <span class="font-mono text-3xl font-extrabold text-[#141413]">
                  ${entry.priceUsd.toLocaleString()}
                </span>
                <span class="font-mono text-xs text-stone-600">
                  ({entry.vramOrBandwidth})
                </span>
              </div>
            </div>

            <div class="mt-4 space-y-1.5 border-t border-stone-300 pt-3 font-mono text-xs">
              <div class="flex items-center justify-between text-stone-700">
                <span>{entry.metricUnit}:</span>
                <strong class="text-[#141413]">{entry.benchmarkMetric}</strong>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-stone-600">Cost / Point:</span>
                <strong
                  class:list={[
                    'font-bold',
                    isBestValue ? 'text-[#15803D]' : 'text-[#B02A14]'
                  ]}
                >
                  ${entry.costPerUnit.toFixed(2)}
                </strong>
              </div>

              <div class="pt-2">
                <a
                  href={entry.amazonUrl}
                  target="_blank"
                  rel="sponsored noopener noreferrer"
                  class:list={[
                    'block w-full border border-[#141413] px-3 py-1.5 text-center font-mono text-[11px] font-bold uppercase transition',
                    isBestValue
                      ? 'bg-[#15803D] text-white hover:bg-[#141413]'
                      : 'bg-white text-[#141413] hover:bg-[#141413] hover:text-white'
                  ]}
                >
                  {isBestValue ? '★ Check Smart-Buy Deal on Amazon →' : 'Compare Price on Amazon →'}
                </a>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>

  <div
    class="border-t-2 border-[#141413] bg-[#141413] px-5 py-3 text-xs text-[#F7F4EE]"
  >
    <strong class="font-mono uppercase text-[#FDECE9]">
      Buyer Advisory:
    </strong>{' '}
    {verdictCallout}
  </div>
</section>
