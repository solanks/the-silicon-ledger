---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import QuickVerdict from '../components/QuickVerdict.astro';
import PolarizedPoll from '../components/PolarizedPoll.astro';
import AdSlot from '../components/AdSlot.astro';
import SpecComparisonTable from '../components/SpecComparisonTable.astro';
import { slugifyTag } from '../config/taxonomy';

export interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const {
  title,
  subtitle,
  description,
  pubDate,
  updatedDate,
  draft,
  category,
  tags,
  readingTimeMinutes,
  author,
  heroImage,
  verdict,
  poll,
  specComparison
} = article.data;

const formattedPubDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<BaseLayout
  title={title}
  description={description}
  slug={article.slug}
  isArticle={true}
  pubDate={pubDate}
  updatedDate={updatedDate}
  category={category}
  tags={tags}
  author={author}
  heroImage={heroImage}
  verdictScore={verdict.score}
>
  <article class="mx-auto max-w-7xl">
    {
      draft && (
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-xs text-slate-900">
          <div class="flex items-center gap-2 font-mono font-bold">
            <span class="rounded bg-rose-600 px-2 py-0.5 text-[10px] uppercase text-white">
              DRAFT DESK
            </span>
            <span>
              Staged on branch <code class="font-bold">draft/{article.slug}</code> · Pending Spec Audit &amp; 10s Mobile Sign-Off
            </span>
          </div>
          <span class="font-mono text-[11px] font-semibold text-rose-700">
            Lifecycle Hook Active
          </span>
        </div>
      )
    }

    <!-- Modern Editorial Article Header -->
    <header class="mb-8 border-b border-slate-200 pb-8">
      <div class="mb-3 flex flex-wrap items-center gap-2.5 font-mono text-xs font-bold uppercase tracking-wider">
        <span class="rounded-lg bg-rose-600 px-3 py-1 text-white shadow-sm">
          {category}
        </span>
        <span class="text-slate-500">
          · {readingTimeMinutes} min read
        </span>
        <div class="flex flex-wrap items-center gap-1.5 pl-1">
          {
            tags.slice(0, 4).map((tag) => (
              <a
                href={`/tags/${slugifyTag(tag)}`}
                class="rounded-md border border-slate-200 bg-white px-2 py-0.5 font-mono text-[11px] font-semibold normal-case text-slate-600 transition hover:border-rose-500 hover:text-rose-600"
              >
                #{tag}
              </a>
            ))
          }
        </div>
      </div>

      <h1
        class="font-serif text-3xl font-extrabold leading-[1.1] tracking-tight text-slate-900 sm:text-5xl lg:text-[50px]"
      >
        {title}
      </h1>

      {
        subtitle && (
          <p class="mt-4 max-w-4xl text-lg leading-relaxed text-slate-600 sm:text-xl">
            {subtitle}
          </p>
        )
      }

      <!-- Author Byline & Timestamps -->
      <div
        class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm"
      >
        <div class="flex items-center gap-3">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-900 font-mono text-xs font-bold text-white"
          >
            {
              author.name
                .split(' ')
                .map((n) => n[0])
                .join('')
            }
          </div>
          <div>
            <div class="flex items-center gap-2">
              <a
                href={author.url}
                class="font-sans text-sm font-bold text-slate-900 hover:text-rose-600"
              >
                {author.name}
              </a>
              <span
                class="rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[10px] font-semibold uppercase text-slate-600"
              >
                Hardware Testing Lab
              </span>
            </div>
            <div class="font-mono text-xs text-slate-500">{author.role}</div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-4 font-mono text-xs text-slate-500">
          <div>
            Filed:{' '}
            <time datetime={pubDate.toISOString()} class="font-semibold text-slate-900">
              {formattedPubDate}
            </time>
          </div>
          {
            updatedDate && (
              <div>
                Updated:{' '}
                <time datetime={updatedDate.toISOString()} class="font-semibold text-rose-600">
                  {formattedUpdatedDate}
                </time>
              </div>
            )
          }
        </div>
      </div>

      <!-- High-Resolution 16:9 Hero Image -->
      <figure class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-md">
        <div class="relative aspect-video w-full overflow-hidden bg-slate-900">
          <img
            src={heroImage.src}
            alt={heroImage.alt}
            width={heroImage.width}
            height={heroImage.height}
            fetchpriority="high"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
        {
          heroImage.caption && (
            <figcaption class="border-t border-slate-200 bg-slate-50 px-4 py-2.5 font-mono text-xs text-slate-600">
              <strong>Lab Bench:</strong> {heroImage.caption}
            </figcaption>
          )
        }
      </figure>
    </header>

    <!-- 12-Column Content + Sticky Ad Rail Grid -->
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
      <!-- Primary Article Column (8 cols) -->
      <div class="lg:col-span-8">
        <!-- Quick Verdict / Pros & Cons at the top of every article template -->
        <QuickVerdict title={title} verdict={verdict} />

        <!-- Article MDX Body with Distinct Section Heading Styling -->
        <div
          id="article-prose-body"
          class="prose prose-slate max-w-none prose-headings:font-sans prose-h2:mt-12 prose-h2:mb-4 prose-h2:border-l-4 prose-h2:border-rose-600 prose-h2:pl-3.5 prose-h2:text-2xl prose-h2:font-extrabold prose-h2:tracking-tight prose-h2:text-slate-900 sm:prose-h2:text-[26px] prose-h3:mt-8 prose-h3:mb-2 prose-h3:text-lg prose-h3:font-bold prose-h3:text-rose-700 prose-p:text-[17px] prose-p:leading-[1.8] prose-p:text-slate-700 prose-a:font-semibold prose-a:text-rose-600 prose-strong:font-bold prose-strong:text-slate-900 prose-code:rounded prose-code:border prose-code:border-slate-200 prose-code:bg-slate-100 prose-code:px-1.5 prose-code:py-0.5 prose-code:font-mono prose-code:text-slate-900"
        >
          <slot />
        </div>

        <!-- Optional Frontmatter-driven Spec Comparison Table -->
        {
          specComparison && (
            <SpecComparisonTable
              title={specComparison.title}
              subtitle={specComparison.subtitle}
              baselineIndex={specComparison.baselineIndex}
              devices={specComparison.devices}
              rows={specComparison.rows}
            />
          )
        }

        <!-- Compact Reader Poll (Moved to the end of the article so it doesn't clutter the top) -->
        <PolarizedPoll
          pollId={article.slug}
          question={poll.question}
          optionA={{
            label: poll.optionALabel,
            subtext: poll.optionASubtext,
            initialVotes: poll.optionAVotes
          }}
          optionB={{
            label: poll.optionBLabel,
            subtext: poll.optionBSubtext,
            initialVotes: poll.optionBVotes
          }}
          hotTakeQuote={poll.hotTakeQuote}
          hotTakeAuthor={poll.hotTakeAuthor}
        />

        <!-- Clickable Article Tags Footer -->
        <div class="mt-8 flex flex-wrap items-center gap-2 border-t border-slate-200 pt-6">
          <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-500">
            Explore Related Topics:
          </span>
          {
            tags.map((tag) => (
              <a
                href={`/tags/${slugifyTag(tag)}`}
                class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 font-mono text-xs font-semibold text-slate-700 shadow-sm transition hover:border-rose-500 hover:bg-rose-50 hover:text-rose-600"
              >
                #{tag}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Sticky Sidebar Rail (4 cols) -->
      <aside class="lg:col-span-4" aria-label="Sidebar & Partner Rail">
        <div class="sticky top-20 space-y-6">
          <AdSlot
            slotId="gam-sidebar-sticky-300x600"
            placement="sidebar-sticky"
            label="Sponsored"
          />
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
