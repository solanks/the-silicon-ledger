---
export interface Props {
  slotId: string;
  placement: 'leaderboard' | 'sidebar-sticky' | 'in-content';
  format?: string;
  minHeight?: string;
  label?: string;
}

const {
  slotId,
  placement,
  minHeight = placement === 'sidebar-sticky'
    ? 'min-h-[250px]'
    : 'min-h-[90px]',
  label = 'Sponsored'
} = Astro.props;

const adsenseClientId =
  import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || 'ca-pub-6428626874238056';
---

<aside
  class="ad-slot-wrapper not-prose my-4 w-full rounded-xl border border-slate-200/80 bg-slate-50/60 px-3.5 py-2.5"
  data-ad-slot={slotId}
  data-ad-placement={placement}
  data-ad-client={adsenseClientId}
  aria-label={`Sponsored: ${label}`}
>
  <div
    class="mb-1.5 flex items-center justify-between font-mono text-[10px] uppercase tracking-wider text-slate-400"
  >
    <span>{label}</span>
    <span>Partner Placement</span>
  </div>

  <div
    class:list={[
      'ad-unit-box relative flex w-full items-center justify-center overflow-hidden rounded-lg bg-white/80',
      minHeight
    ]}
  >
    <ins
      class="adsbygoogle block w-full"
      style="display:block"
      data-ad-client={adsenseClientId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    />
  </div>
</aside>
