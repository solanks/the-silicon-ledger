---
export interface TranslationItem {
  prQuote: string;
  cynicTranslation: string;
  walletImpact: string;
}

export interface Props {
  companyName?: string;
  bsScore?: number;
  translations: TranslationItem[];
}

const {
  companyName = 'Keynote Claims',
  bsScore = 9.2,
  translations = []
} = Astro.props;
---

<section
  class="not-prose my-10 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
  aria-label="Marketing Spin vs. Lab Reality"
>
  <div
    class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 bg-slate-50 px-6 py-4"
  >
    <div>
      <div class="font-mono text-[11px] font-bold uppercase tracking-wider text-rose-600">
        PR Spin Translator
      </div>
      <h3 class="mt-0.5 font-sans text-lg font-extrabold text-slate-900">
        What They Claimed vs. What We Measured ({companyName})
      </h3>
    </div>

    <div
      class="rounded-lg bg-rose-50 px-3 py-1 font-mono text-xs font-bold text-rose-700 ring-1 ring-rose-200"
    >
      Spin Rating: {bsScore.toFixed(1)}/10
    </div>
  </div>

  <div class="divide-y divide-slate-100">
    {
      translations.map((item) => (
        <div class="grid gap-4 p-6 md:grid-cols-12 md:items-center">
          <div class="rounded-xl bg-slate-50 p-4 md:col-span-5">
            <div class="mb-1 font-mono text-[10px] font-bold uppercase tracking-wider text-slate-400">
              Official Claim
            </div>
            <p class="font-serif text-sm italic leading-relaxed text-slate-700">
              “{item.prQuote}”
            </p>
          </div>

          <div class="flex items-center justify-center font-mono text-sm font-bold text-slate-400 md:col-span-1">
            →
          </div>

          <div class="rounded-xl border border-rose-100 bg-rose-50/40 p-4 md:col-span-6">
            <div class="mb-1 flex flex-wrap items-center justify-between gap-2">
              <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-rose-600">
                Lab Reality
              </span>
              <span class="rounded bg-white px-2 py-0.5 font-mono text-[10px] font-semibold text-slate-700 shadow-sm">
                {item.walletImpact}
              </span>
            </div>
            <p class="text-sm leading-relaxed text-slate-800">
              {item.cynicTranslation}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
