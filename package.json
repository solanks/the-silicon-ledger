{
  "name": "the-silicon-ledger",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Astro + Tailwind CSS static/hybrid tech blog optimized for Google Discover and high ad viewability",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate:viral": "python3 scripts/generate_viral_articles.py",
    "generate:article": "python3 scripts/generate_article_pipeline.py",
    "generate:dry-run": "python3 scripts/generate_article_pipeline.py --dry-run",
    "verify:site": "python3 scripts/verify_and_polish_site.py --audit",
    "verify:images": "python3 scripts/verify_and_polish_site.py --check-image-diversity"
  },
  "dependencies": {
    "@astrojs/mdx": "^3.1.7",
    "@astrojs/rss": "^4.0.7",
    "@astrojs/tailwind": "^5.1.2",
    "@tailwindcss/typography": "^0.5.15",
    "astro": "^4.16.10",
    "tailwindcss": "^3.4.14"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
