---
export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  slug?: string;
  isArticle?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  category?: string;
  tags?: string[];
  author?: {
    name: string;
    role?: string;
    url?: string;
  };
  heroImage?: {
    src: string;
    alt: string;
    width?: number;
    height?: number;
  };
  verdictScore?: number;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  slug,
  isArticle = false,
  pubDate,
  updatedDate,
  category = 'Hardware',
  tags = [],
  author = {
    name: 'Elena Vance',
    role: 'Chief Silicon Architect',
    url: 'https://techpulse.example.com/authors/elena-vance'
  },
  heroImage,
  verdictScore
} = Astro.props;

const siteUrl = Astro.site?.origin ?? 'https://techpulse.example.com';

// High-contrast generated OpenGraph image URL for articles
const ogImageUrl = slug
  ? `${siteUrl}/og/${slug}.png`
  : `${siteUrl}/og/default.png`;

const heroAbsoluteUrl = heroImage?.src
  ? heroImage.src.startsWith('http')
    ? heroImage.src
    : `${siteUrl}${heroImage.src}`
  : ogImageUrl;

// Construct automatic NewsArticle JSON-LD Schema for Google Discover & Top Stories
const newsArticleJsonLd = isArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl
      },
      headline: title.slice(0, 110),
      description: description,
      image: [
        {
          '@type': 'ImageObject',
          url: heroAbsoluteUrl,
          width: heroImage?.width ?? 1600,
          height: heroImage?.height ?? 900
        },
        {
          '@type': 'ImageObject',
          url: ogImageUrl,
          width: 1200,
          height: 630
        }
      ],
      datePublished: pubDate ? pubDate.toISOString() : new Date().toISOString(),
      dateModified: (updatedDate ?? pubDate ?? new Date()).toISOString(),
      articleSection: category,
      keywords: tags.join(', '),
      author: [
        {
          '@type': 'Person',
          name: author.name,
          jobTitle: author.role,
          url: author.url ?? `${siteUrl}/authors`
        }
      ],
      publisher: {
        '@type': 'Organization',
        name: 'TechPulse Labs',
        url: siteUrl,
        logo: {
          '@type': 'ImageObject',
          url: `${siteUrl}/logo-schema.png`,
          width: 600,
          height: 60
        }
      },
      isAccessibleForFree: true,
      ...(typeof verdictScore === 'number'
        ? {
            reviewRating: {
              '@type': 'Rating',
              ratingValue: verdictScore,
              bestRating: 10,
              worstRating: 1
            }
          }
        : {})
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'TechPulse Labs',
      url: siteUrl,
      description
    };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title} | TechPulse Labs</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Critical Google Discover Directives: max-image-preview:large is mandatory for large Discover cards -->
<meta
  name="robots"
  content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
/>
<meta name="googlebot" content="index, follow, max-image-preview:large" />

<!-- RSS Feed for Google Discover / Google News Follow feature -->
<link
  rel="alternate"
  type="application/rss+xml"
  title="TechPulse Labs Hardware & Silicon Feed"
  href={`${siteUrl}/rss.xml`}
/>

<!-- OpenGraph Metadata with High-Contrast Generated OG Image -->
<meta property="og:site_name" content="TechPulse Labs" />
<meta property="og:type" content={isArticle ? 'article' : 'website'} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content={heroImage?.alt ?? `${title} — TechPulse Labs Review`}
/>

{
  isArticle && pubDate && (
    <meta property="article:published_time" content={pubDate.toISOString()} />
  )
}
{
  isArticle && (updatedDate ?? pubDate) && (
    <meta
      property="article:modified_time"
      content={(updatedDate ?? pubDate)!.toISOString()}
    />
  )
}
{isArticle && category && <meta property="article:section" content={category} />}
{
  isArticle &&
    tags.map((tag) => <meta property="article:tag" content={tag} />)
}

<!-- Twitter / X Large Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Automatic NewsArticle / WebSite JSON-LD Schema -->
<script
  type="application/ld+json"
  set:html={JSON.stringify(newsArticleJsonLd)}
/>
