---
export interface UpgradeCandidate {
  id: string;
  name: string;
  year: number;
  computeScore: number;
  bandwidthGbS: number;
  resaleValueUsd: number;
}

export interface Props {
  newDeviceName: string;
  newDevicePriceUsd: number;
  newDeviceComputeScore: number;
  newDeviceBandwidthGbS: number;
  candidates?: UpgradeCandidate[];
}

const {
  newDeviceName = 'M5 MacBook Pro 14" (Base)',
  newDevicePriceUsd = 1599,
  newDeviceComputeScore = 940,
  newDeviceBandwidthGbS = 120,
  candidates = [
    {
      id: 'm1-pro-2021',
      name: '2021 M1 Pro MacBook Pro 14" (16GB/512GB)',
      year: 2021,
      computeScore: 910,
      bandwidthGbS: 200,
      resaleValueUsd: 780
    },
    {
      id: 'm2-air-2022',
      name: '2022 M2 MacBook Air 13" (8GB/256GB)',
      year: 2022,
      computeScore: 540,
      bandwidthGbS: 100,
      resaleValueUsd: 590
    },
    {
      id: 'm3-pro-2023',
      name: '2023 M3 Pro MacBook Pro 14" (18GB/512GB)',
      year: 2023,
      computeScore: 1290,
      bandwidthGbS: 150,
      resaleValueUsd: 1180
    },
    {
      id: 'm4-pro-2024',
      name: '2024 M4 Pro MacBook Pro 14" (24GB/512GB)',
      year: 2024,
      computeScore: 1620,
      bandwidthGbS: 273,
      resaleValueUsd: 1350
    }
  ]
} = Astro.props;
---

<section
  class="upgrade-calculator-trap not-prose my-10 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
  data-new-price={newDevicePriceUsd}
  data-new-compute={newDeviceComputeScore}
  data-new-bandwidth={newDeviceBandwidthGbS}
  data-new-name={newDeviceName}
>
  <div
    class="border-b border-slate-100 bg-slate-50 px-6 py-4"
  >
    <div class="font-mono text-[11px] font-bold uppercase tracking-wider text-blue-600">
      Interactive Upgrade Calculator
    </div>
    <h3 class="mt-0.5 font-sans text-lg font-extrabold text-slate-900">
      Should You Upgrade to {newDeviceName}?
    </h3>
  </div>

  <div class="space-y-4 p-6">
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class="mb-1.5 block font-sans text-xs font-bold text-slate-700">
          1. Select Your Current Device:
        </span>
        <select
          class="calc-device-select w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-xs font-semibold text-slate-900 focus:border-blue-500 focus:bg-white focus:outline-none"
        >
          {
            candidates.map((c, idx) => (
              <option
                value={c.id}
                data-compute={c.computeScore}
                data-bandwidth={c.bandwidthGbS}
                data-resale={c.resaleValueUsd}
                selected={idx === 0}
              >
                {c.name}
              </option>
            ))
          }
        </select>
      </label>

      <label class="block">
        <span class="mb-1.5 block font-sans text-xs font-bold text-slate-700">
          2. Select Your Primary Workload:
        </span>
        <select
          class="calc-workload-select w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-xs font-semibold text-slate-900 focus:border-blue-500 focus:bg-white focus:outline-none"
        >
          <option value="sustained">Heavy Multitasking / Video / 3D (Sustained)</option>
          <option value="burst">Everyday Web / Office / Travel (Burst)</option>
          <option value="gaming">Gaming &amp; High-Refresh Display</option>
        </select>
      </label>
    </div>

    <div class="grid grid-cols-3 gap-3">
      <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-3 text-center">
        <div class="font-mono text-[10px] font-semibold uppercase text-slate-400">
          Net Upgrade Cost
        </div>
        <div class="calc-net-cost mt-1 font-mono text-xl font-extrabold text-slate-900">
          $819
        </div>
        <div class="calc-resale-note font-mono text-[10px] text-slate-500">
          After $780 trade-in
        </div>
      </div>

      <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-3 text-center">
        <div class="font-mono text-[10px] font-semibold uppercase text-slate-400">
          Speed Change
        </div>
        <div class="calc-compute-delta mt-1 font-mono text-xl font-extrabold text-amber-600">
          +3%
        </div>
        <div class="font-mono text-[10px] text-slate-500">
          Sustained Load
        </div>
      </div>

      <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-3 text-center">
        <div class="font-mono text-[10px] font-semibold uppercase text-slate-400">
          Bandwidth Delta
        </div>
        <div class="calc-bw-delta mt-1 font-mono text-xl font-extrabold text-rose-600">
          -40%
        </div>
        <div class="font-mono text-[10px] text-slate-500">
          Memory / Bus
        </div>
      </div>
    </div>

    <div
      class="calc-verdict-box rounded-xl border border-rose-200 bg-rose-50/50 p-4"
    >
      <div class="flex items-center justify-between gap-2">
        <span
          class="calc-verdict-badge rounded-md bg-rose-600 px-2.5 py-0.5 font-mono text-[11px] font-bold uppercase text-white"
        >
          Skip — Keep Your Current Gear
        </span>
        <span class="calc-cost-per-pct font-mono text-xs font-semibold text-slate-600">
          $248 per 1% gain
        </span>
      </div>
      <p class="calc-verdict-text mt-2 text-xs leading-relaxed text-slate-700">
        You would pay $819 out-of-pocket for a negligible +3% sustained speedup. Keep your current setup or look at a discounted Pro tier instead.
      </p>
    </div>
  </div>
</section>

<script>
  function initUpgradeCalculators() {
    const widgets = document.querySelectorAll<HTMLElement>('.upgrade-calculator-trap');

    widgets.forEach((widget) => {
      const newPrice = Number.parseFloat(widget.dataset.newPrice ?? '1599');
      const newCompute = Number.parseFloat(widget.dataset.newCompute ?? '940');
      const newBandwidth = Number.parseFloat(widget.dataset.newBandwidth ?? '120');

      const devSelect = widget.querySelector<HTMLSelectElement>('.calc-device-select');
      const workSelect = widget.querySelector<HTMLSelectElement>('.calc-workload-select');

      const netCostEl = widget.querySelector<HTMLElement>('.calc-net-cost');
      const resaleNoteEl = widget.querySelector<HTMLElement>('.calc-resale-note');
      const computeDeltaEl = widget.querySelector<HTMLElement>('.calc-compute-delta');
      const bwDeltaEl = widget.querySelector<HTMLElement>('.calc-bw-delta');
      const verdictBox = widget.querySelector<HTMLElement>('.calc-verdict-box');
      const verdictBadge = widget.querySelector<HTMLElement>('.calc-verdict-badge');
      const costPerPctEl = widget.querySelector<HTMLElement>('.calc-cost-per-pct');
      const verdictText = widget.querySelector<HTMLElement>('.calc-verdict-text');

      const recalculate = () => {
        const opt = devSelect?.selectedOptions[0];
        if (!opt) return;

        const curCompute = Number.parseFloat(opt.dataset.compute ?? '910');
        const curBw = Number.parseFloat(opt.dataset.bandwidth ?? '200');
        const curResale = Number.parseFloat(opt.dataset.resale ?? '780');
        const workload = workSelect?.value ?? 'sustained';

        const netCost = Math.max(0, newPrice - curResale);
        const rawComputePct = ((newCompute - curCompute) / curCompute) * 100;
        const effectiveComputePct =
          workload === 'burst' ? rawComputePct + 28 : rawComputePct;
        const bwPct = ((newBandwidth - curBw) / curBw) * 100;

        if (netCostEl) netCostEl.textContent = `$${netCost.toLocaleString()}`;
        if (resaleNoteEl) resaleNoteEl.textContent = `After $${curResale} resale`;

        if (computeDeltaEl) {
          computeDeltaEl.textContent = `${effectiveComputePct >= 0 ? '+' : ''}${effectiveComputePct.toFixed(0)}%`;
          computeDeltaEl.className = `calc-compute-delta mt-1 font-mono text-xl font-extrabold ${
            effectiveComputePct >= 20
              ? 'text-emerald-600'
              : effectiveComputePct >= 0
                ? 'text-amber-600'
                : 'text-rose-600'
          }`;
        }

        if (bwDeltaEl) {
          bwDeltaEl.textContent = `${bwPct >= 0 ? '+' : ''}${bwPct.toFixed(0)}%`;
          bwDeltaEl.className = `calc-bw-delta mt-1 font-mono text-xl font-extrabold ${
            bwPct >= 0 ? 'text-emerald-600' : 'text-rose-600'
          }`;
        }

        if (effectiveComputePct <= 10 || bwPct < -10) {
          if (verdictBox) verdictBox.className = 'calc-verdict-box rounded-xl border border-rose-200 bg-rose-50/50 p-4';
          if (verdictBadge) {
            verdictBadge.textContent = 'Skip — Poor Upgrade Value';
            verdictBadge.className =
              'calc-verdict-badge rounded-md bg-rose-600 px-2.5 py-0.5 font-mono text-[11px] font-bold uppercase text-white';
          }
          if (costPerPctEl) {
            costPerPctEl.textContent =
              effectiveComputePct > 0
                ? `$${Math.round(netCost / effectiveComputePct)} per 1% gain`
                : 'Low ROI';
          }
          if (verdictText) {
            verdictText.textContent = `Paying $${netCost} out-of-pocket yields a ${bwPct.toFixed(0)}% bandwidth change and only ${effectiveComputePct.toFixed(0)}% workload gain. Keep your current setup or choose a discounted Pro tier.`;
          }
        } else {
          if (verdictBox) verdictBox.className = 'calc-verdict-box rounded-xl border border-emerald-200 bg-emerald-50/50 p-4';
          if (verdictBadge) {
            verdictBadge.textContent = 'Worthwhile Upgrade';
            verdictBadge.className =
              'calc-verdict-badge rounded-md bg-emerald-600 px-2.5 py-0.5 font-mono text-[11px] font-bold uppercase text-white';
          }
          if (costPerPctEl) {
            costPerPctEl.textContent = `$${Math.round(netCost / Math.max(1, effectiveComputePct))} per 1% gain`;
          }
          if (verdictText) {
            verdictText.textContent = `Upgrading from ${opt.textContent?.trim()} nets a +${effectiveComputePct.toFixed(0)}% boost for ~$${netCost} after trade-in.`;
          }
        }
      };

      devSelect?.addEventListener('change', recalculate);
      workSelect?.addEventListener('change', recalculate);
      recalculate();
    });
  }

  initUpgradeCalculators();
  document.addEventListener('astro:after-swap', initUpgradeCalculators);
</script>
