---
export interface Props {
  pollId?: string;
  question: string;
  optionA: {
    label: string;
    subtext?: string;
    initialVotes?: number;
  };
  optionB: {
    label: string;
    subtext?: string;
    initialVotes?: number;
  };
  hotTakeQuote?: string;
  hotTakeAuthor?: string;
}

const {
  pollId = 'default-hardware-poll',
  question,
  optionA,
  optionB,
  hotTakeQuote,
  hotTakeAuthor
} = Astro.props;

const votesA = optionA.initialVotes ?? 1842;
const votesB = optionB.initialVotes ?? 519;
const totalInitial = votesA + votesB;
---

<section
  class="polarized-poll-widget not-prose my-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
  data-poll-id={pollId}
  data-votes-a={votesA}
  data-votes-b={votesB}
>
  <div class="mb-2 flex items-center justify-between gap-2">
    <span class="rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-slate-600">
      Reader Poll
    </span>
    <span class="poll-total-counter font-mono text-[11px] text-slate-400">
      {totalInitial.toLocaleString()} votes
    </span>
  </div>

  <h3 class="font-sans text-base font-bold leading-snug text-slate-900">
    {question}
  </h3>

  <div class="mt-3 grid gap-2.5 sm:grid-cols-2">
    <button
      type="button"
      class="poll-option-btn group relative overflow-hidden rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2.5 text-left transition hover:border-rose-400 hover:bg-white"
      data-choice="A"
    >
      <div
        class="poll-bar-fill pointer-events-none absolute inset-y-0 left-0 w-0 bg-rose-500/10 transition-all duration-500"
      ></div>
      <div class="relative z-10 flex items-center justify-between gap-2">
        <div>
          <div class="text-xs font-bold text-slate-900 group-hover:text-rose-600">
            {optionA.label}
          </div>
          {
            optionA.subtext && (
              <div class="mt-0.5 text-[11px] text-slate-500">{optionA.subtext}</div>
            )
          }
        </div>
        <span
          class="poll-pct-label hidden rounded-md bg-rose-600 px-2 py-0.5 font-mono text-[11px] font-bold text-white"
        >
          0%
        </span>
      </div>
    </button>

    <button
      type="button"
      class="poll-option-btn group relative overflow-hidden rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2.5 text-left transition hover:border-slate-400 hover:bg-white"
      data-choice="B"
    >
      <div
        class="poll-bar-fill pointer-events-none absolute inset-y-0 left-0 w-0 bg-slate-400/15 transition-all duration-500"
      ></div>
      <div class="relative z-10 flex items-center justify-between gap-2">
        <div>
          <div class="text-xs font-bold text-slate-900">
            {optionB.label}
          </div>
          {
            optionB.subtext && (
              <div class="mt-0.5 text-[11px] text-slate-500">{optionB.subtext}</div>
            )
          }
        </div>
        <span
          class="poll-pct-label hidden rounded-md bg-slate-800 px-2 py-0.5 font-mono text-[11px] font-bold text-white"
        >
          0%
        </span>
      </div>
    </button>
  </div>

  {
    hotTakeQuote && (
      <div class="poll-drama-reveal mt-3 hidden rounded-xl bg-slate-50 p-3 text-xs text-slate-600">
        <p class="italic text-slate-700">“{hotTakeQuote}”</p>
        {hotTakeAuthor && (
          <div class="mt-1 font-mono text-[10px] text-slate-400">{hotTakeAuthor}</div>
        )}
      </div>
    )
  }
</section>

<script>
  function initPolarizedPolls() {
    const polls = document.querySelectorAll<HTMLElement>('.polarized-poll-widget');

    polls.forEach((widget) => {
      const pollId = widget.dataset.pollId ?? 'default';
      const storageKey = `techpulse_poll_${pollId}`;
      const votesA = Number.parseInt(widget.dataset.votesA ?? '1500', 10);
      const votesB = Number.parseInt(widget.dataset.votesB ?? '500', 10);

      const buttons = widget.querySelectorAll<HTMLButtonElement>('.poll-option-btn');
      const totalCounter = widget.querySelector<HTMLElement>('.poll-total-counter');
      const dramaReveal = widget.querySelector<HTMLElement>('.poll-drama-reveal');

      const renderResults = (choice: 'A' | 'B') => {
        const finalA = choice === 'A' ? votesA + 1 : votesA;
        const finalB = choice === 'B' ? votesB + 1 : votesB;
        const total = finalA + finalB;
        const pctA = Math.round((finalA / total) * 100);
        const pctB = 100 - pctA;

        buttons.forEach((btn) => {
          const btnChoice = btn.dataset.choice;
          const pct = btnChoice === 'A' ? pctA : pctB;
          const bar = btn.querySelector<HTMLElement>('.poll-bar-fill');
          const label = btn.querySelector<HTMLElement>('.poll-pct-label');

          if (bar) bar.style.width = `${pct}%`;
          if (label) {
            label.textContent = `${pct}%`;
            label.classList.remove('hidden');
          }
        });

        if (totalCounter) {
          totalCounter.textContent = `${total.toLocaleString()} votes`;
        }
        dramaReveal?.classList.remove('hidden');
      };

      const savedChoice = window.localStorage.getItem(storageKey);
      if (savedChoice === 'A' || savedChoice === 'B') {
        renderResults(savedChoice);
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const choice = btn.dataset.choice === 'A' ? 'A' : 'B';
          window.localStorage.setItem(storageKey, choice);
          renderResults(choice);
        });
      });
    });
  }

  initPolarizedPolls();
  document.addEventListener('astro:after-swap', initPolarizedPolls);
</script>
