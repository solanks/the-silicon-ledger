---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import QuickVerdict from '../components/QuickVerdict.astro';
import PolarizedPoll from '../components/PolarizedPoll.astro';
import AdSlot from '../components/AdSlot.astro';
import SpecComparisonTable from '../components/SpecComparisonTable.astro';

export interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const {
  title,
  subtitle,
  description,
  pubDate,
  updatedDate,
  draft,
  category,
  tags,
  readingTimeMinutes,
  author,
  heroImage,
  verdict,
  poll,
  specComparison
} = article.data;

const formattedPubDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<BaseLayout
  title={title}
  description={description}
  slug={article.slug}
  isArticle={true}
  pubDate={pubDate}
  updatedDate={updatedDate}
  category={category}
  tags={tags}
  author={author}
  heroImage={heroImage}
  verdictScore={verdict.score}
>
  <article class="mx-auto max-w-7xl">
    <!-- Draft / PR Preview Banner -->
    {
      draft && (
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3 border-2 border-[#141413] bg-[#FDECE9] px-4 py-3 text-xs text-[#141413]">
          <div class="flex items-center gap-2 font-mono font-bold">
            <span class="bg-[#D9381E] px-2 py-0.5 text-[10px] uppercase text-white">
              DRAFT DESK
            </span>
            <span>
              Staged on branch <code class="font-bold">draft/{article.slug}</code> · Pending Spec Audit &amp; 10s Mobile Sign-Off
            </span>
          </div>
          <span class="font-mono text-[11px] font-semibold text-[#B02A14]">
            Lifecycle Hook Active
          </span>
        </div>
      )
    }

    <!-- Editorial Article Header -->
    <header class="mb-8 border-b-2 border-[#141413] pb-8">
      <div class="mb-3 flex flex-wrap items-center gap-3 font-mono text-xs font-bold uppercase tracking-wider">
        <span class="bg-[#D9381E] px-2.5 py-0.5 text-white">
          {category}
        </span>
        <span class="text-stone-600">
          {readingTimeMinutes} min read
        </span>
      </div>

      <h1
        class="font-serif text-4xl font-extrabold leading-[1.08] tracking-tight text-[#141413] sm:text-5xl lg:text-[54px]"
      >
        {title}
      </h1>

      {
        subtitle && (
          <p class="mt-4 max-w-4xl font-serif text-xl italic leading-relaxed text-stone-700 sm:text-2xl">
            {subtitle}
          </p>
        )
      }

      <!-- Author Byline & Timestamps -->
      <div
        class="mt-6 flex flex-wrap items-center justify-between gap-4 border-y border-stone-300 bg-[#EFECE4] px-4 py-3"
      >
        <div class="flex items-center gap-3">
          <div
            class="flex h-10 w-10 items-center justify-center border border-[#141413] bg-[#141413] font-mono text-xs font-bold text-[#F7F4EE]"
          >
            {
              author.name
                .split(' ')
                .map((n) => n[0])
                .join('')
            }
          </div>
          <div>
            <div class="flex items-center gap-2">
              <a
                href={author.url}
                class="font-sans text-sm font-bold text-[#141413] hover:text-[#D9381E]"
              >
                {author.name}
              </a>
              <span
                class="border border-stone-400 bg-[#F7F4EE] px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase text-stone-700"
              >
                Hardware Testing Desk
              </span>
            </div>
            <div class="font-mono text-xs text-stone-600">{author.role}</div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-4 font-mono text-xs text-stone-600">
          <div>
            Filed:{' '}
            <time datetime={pubDate.toISOString()} class="font-semibold text-[#141413]">
              {formattedPubDate}
            </time>
          </div>
          {
            updatedDate && (
              <div>
                Updated:{' '}
                <time datetime={updatedDate.toISOString()} class="font-semibold text-[#D9381E]">
                  {formattedUpdatedDate}
                </time>
              </div>
            )
          }
        </div>
      </div>

      <!-- High-Resolution 16:9 Hero Image (>=1200px wide for Google Discover) -->
      <figure class="mt-6 border-2 border-[#141413] bg-[#FCFBF8]">
        <div class="relative aspect-video w-full overflow-hidden bg-stone-900">
          <img
            src={heroImage.src}
            alt={heroImage.alt}
            width={heroImage.width}
            height={heroImage.height}
            fetchpriority="high"
            decoding="async"
            class="h-full w-full object-cover"
          />
          {
            heroImage.focalCallout && (
              <div class="absolute bottom-4 left-4 border-2 border-[#141413] bg-[#D9381E] px-3.5 py-1.5 font-mono text-xs font-bold uppercase text-white shadow-[3px_3px_0px_#141413]">
                Teardown Callout: {heroImage.focalCallout}
              </div>
            )
          }
        </div>
        {
          heroImage.caption && (
            <figcaption class="border-t-2 border-[#141413] bg-[#EFECE4] px-4 py-2.5 font-mono text-xs text-stone-700">
              <strong>Fig 1.</strong> {heroImage.caption}
            </figcaption>
          )
        }
      </figure>
    </header>

    <!-- 12-Column Content + Sticky Ad Rail Grid -->
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
      <!-- Primary Article Column (8 cols) -->
      <div class="lg:col-span-8">
        <!-- Above-the-Fold Polarized Two-Option Poll -->
        <PolarizedPoll
          pollId={article.slug}
          question={poll.question}
          optionA={{
            label: poll.optionALabel,
            subtext: poll.optionASubtext,
            initialVotes: poll.optionAVotes
          }}
          optionB={{
            label: poll.optionBLabel,
            subtext: poll.optionBSubtext,
            initialVotes: poll.optionBVotes
          }}
          hotTakeQuote={poll.hotTakeQuote}
          hotTakeAuthor={poll.hotTakeAuthor}
        />

        <!-- Quick Verdict / Pros & Cons at the top of every article template -->
        <QuickVerdict title={title} verdict={verdict} />

        <!-- Article MDX Body -->
        <div
          id="article-prose-body"
          class="prose prose-stone max-w-none prose-headings:font-serif prose-headings:font-extrabold prose-headings:text-[#141413] prose-p:text-[17px] prose-p:leading-[1.75] prose-p:text-[#141413] prose-a:font-semibold prose-a:text-[#D9381E] prose-strong:text-[#141413] prose-code:border prose-code:border-stone-300 prose-code:bg-[#EFECE4] prose-code:px-1.5 prose-code:py-0.5 prose-code:font-mono prose-code:text-[#141413] prose-th:border prose-th:border-stone-400 prose-th:bg-[#EFECE4] prose-th:p-2.5 prose-td:border prose-td:border-stone-300 prose-td:p-2.5"
        >
          <slot />
        </div>

        <!-- Optional Frontmatter-driven Spec Comparison Table -->
        {
          specComparison && (
            <SpecComparisonTable
              title={specComparison.title}
              subtitle={specComparison.subtitle}
              baselineIndex={specComparison.baselineIndex}
              devices={specComparison.devices}
              rows={specComparison.rows}
            />
          )
        }

        <!-- Article Tags Footer -->
        <div class="mt-10 flex flex-wrap items-center gap-2 border-t-2 border-[#141413] pt-6">
          <span class="font-mono text-xs font-bold uppercase tracking-wider text-stone-600">
            Filed Under:
          </span>
          {
            tags.map((tag) => (
              <span class="border border-[#141413] bg-[#EFECE4] px-2.5 py-1 font-mono text-xs font-semibold text-[#141413]">
                {tag}
              </span>
            ))
          }
        </div>
      </div>

      <!-- Sticky Sidebar Rail (4 cols) -->
      <aside class="lg:col-span-4" aria-label="Sidebar & High-Viewability Ad Rail">
        <div class="sticky top-16 space-y-6">
          <!-- Sticky Sidebar Ad Slot (300x600 Half-Page Unit with 30s Active View Auto-Refresh) -->
          <AdSlot
            slotId="gam-sidebar-sticky-300x600"
            placement="sidebar-sticky"
            label="Sticky Rail (30s Refresh)"
          />
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
