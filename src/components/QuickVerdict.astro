---
import { buildAmazonAffiliateUrl } from '../config/monetization';

export interface Props {
  title: string;
  verdict: {
    score: number;
    award?: string;
    summary: string;
    pros: string[];
    cons: string[];
    price?: string;
    buyUrl?: string;
  };
}

const { title, verdict } = Astro.props;
const affiliateHref = buildAmazonAffiliateUrl(verdict.buyUrl || title, title);

const scoreStyle =
  verdict.score >= 8.5
    ? {
        bg: 'bg-emerald-600 text-white',
        label: 'Lab Approved'
      }
    : verdict.score >= 7.0
      ? {
          bg: 'bg-amber-600 text-white',
          label: 'Solid w/ Caveats'
        }
      : {
          bg: 'bg-rose-600 text-white',
          label: 'Skip / Wait'
        };
---

<section
  class="not-prose my-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
  aria-labelledby="quick-verdict-heading"
>
  <!-- Top Bar -->
  <div
    class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 bg-slate-900 px-6 py-3 text-white"
  >
    <h2
      id="quick-verdict-heading"
      class="font-mono text-xs font-bold uppercase tracking-widest text-white"
    >
      The Lab Verdict
    </h2>

    <div class="flex items-center gap-2 font-mono text-xs">
      {
        verdict.award && (
          <span class="rounded-md bg-rose-600 px-2.5 py-0.5 font-bold text-white">
            {verdict.award}
          </span>
        )
      }
      {
        verdict.price && (
          <span class="rounded-md bg-slate-800 px-2.5 py-0.5 text-slate-200">
            {verdict.price}
          </span>
        )
      }
    </div>
  </div>

  <!-- Score + Summary Block -->
  <div
    class="grid gap-6 border-b border-slate-100 p-6 md:grid-cols-[auto_1fr] md:items-center"
  >
    <div
      class:list={[
        'flex flex-col items-center justify-center rounded-2xl px-6 py-4 text-center shadow-sm',
        scoreStyle.bg
      ]}
    >
      <div class="flex items-baseline gap-0.5">
        <span class="font-serif text-4xl font-extrabold tracking-tight">
          {verdict.score.toFixed(1)}
        </span>
        <span class="font-mono text-xs font-bold opacity-80">/10</span>
      </div>
      <span
        class="mt-1 font-mono text-[10px] font-bold uppercase tracking-wider"
      >
        {scoreStyle.label}
      </span>
    </div>

    <div class="space-y-3">
      <p class="text-base leading-relaxed text-slate-700">
        {verdict.summary}
      </p>
      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a
          href={affiliateHref}
          target="_blank"
          rel="sponsored noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2 text-xs font-bold text-white shadow-sm transition hover:bg-rose-600"
        >
          <span>View on Amazon</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Pros & Cons 2-Column Grid -->
  <div class="grid divide-y divide-slate-100 md:grid-cols-2 md:divide-x md:divide-y-0">
    <!-- Pros -->
    <div class="bg-slate-50/40 p-6">
      <h3
        class="mb-3 font-sans text-xs font-extrabold uppercase tracking-wider text-emerald-700"
      >
        ✓ The Good
      </h3>
      <ul class="space-y-2">
        {
          verdict.pros.map((pro) => (
            <li class="flex items-start gap-2 text-sm leading-snug text-slate-700">
              <span class="mt-0.5 font-mono font-bold text-emerald-600">+</span>
              <span>{pro}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Cons -->
    <div class="bg-slate-50/40 p-6">
      <h3
        class="mb-3 font-sans text-xs font-extrabold uppercase tracking-wider text-rose-600"
      >
        ✕ The Bad
      </h3>
      <ul class="space-y-2">
        {
          verdict.cons.map((con) => (
            <li class="flex items-start gap-2 text-sm leading-snug text-slate-700">
              <span class="mt-0.5 font-mono font-bold text-rose-600">−</span>
              <span>{con}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
