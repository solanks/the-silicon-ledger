---
import { buildAmazonAffiliateUrl } from '../config/monetization';

export interface StreetPriceEntry {
  modelName: string;
  sourceLabel: string;
  priceUsd: number;
  benchmarkMetric: number;
  metricUnit: string;
  vramOrBandwidth: string;
  isNewRelease?: boolean;
}

export interface Props {
  title?: string;
  taxLabel?: string;
  brandTaxPct: number;
  verdictCallout: string;
  entries: StreetPriceEntry[];
}

const {
  title = 'Where to Buy & Smart Alternatives',
  verdictCallout,
  entries = []
} = Astro.props;

const computedEntries = entries.map((e) => {
  const costPerUnit = e.benchmarkMetric > 0 ? e.priceUsd / e.benchmarkMetric : 0;
  const amazonUrl = buildAmazonAffiliateUrl(e.modelName);
  return {
    ...e,
    costPerUnit,
    amazonUrl
  };
});

const bestCostPerUnit = Math.min(
  ...computedEntries.map((e) => e.costPerUnit || 999999)
);
---

<section
  class="not-prose my-10 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
  aria-label="Price Comparison and Buying Options"
>
  <div class="border-b border-slate-100 bg-slate-50/80 px-6 py-4">
    <div class="font-mono text-[11px] font-bold uppercase tracking-wider text-emerald-700">
      Buying Options &amp; Price Check
    </div>
    <h3 class="mt-0.5 font-sans text-lg font-extrabold text-slate-900">
      {title}
    </h3>
  </div>

  <div class="divide-y divide-slate-100">
    {
      computedEntries.map((entry) => {
        const isBestValue = Math.abs(entry.costPerUnit - bestCostPerUnit) < 0.0001;
        return (
          <div
            class:list={[
              'flex flex-col justify-between gap-4 px-6 py-4 sm:flex-row sm:items-center',
              isBestValue ? 'bg-emerald-50/30' : 'bg-white'
            ]}
          >
            <div class="space-y-1">
              <div class="flex flex-wrap items-center gap-2">
                <h4 class="font-sans text-sm font-bold text-slate-900">
                  {entry.modelName}
                </h4>
                {isBestValue ? (
                  <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 font-mono text-[10px] font-bold text-emerald-800">
                    ★ Best Value Pick
                  </span>
                ) : entry.isNewRelease ? (
                  <span class="rounded-full bg-slate-100 px-2.5 py-0.5 font-mono text-[10px] font-medium text-slate-600">
                    Tested Release
                  </span>
                ) : null}
              </div>

              <div class="font-mono text-xs text-slate-500">
                {entry.vramOrBandwidth} · {entry.benchmarkMetric} {entry.metricUnit}
              </div>
            </div>

            <div class="flex shrink-0 items-center gap-4">
              <div class="text-right">
                <div class="font-mono text-lg font-extrabold text-slate-900">
                  ${entry.priceUsd.toLocaleString()}
                </div>
                <div class="font-mono text-[10px] text-slate-400">
                  {entry.sourceLabel}
                </div>
              </div>

              <a
                href={entry.amazonUrl}
                target="_blank"
                rel="sponsored noopener noreferrer"
                class:list={[
                  'inline-flex items-center gap-1.5 rounded-xl px-4 py-2.5 font-sans text-xs font-bold transition shadow-sm',
                  isBestValue
                    ? 'bg-emerald-600 text-white hover:bg-emerald-700'
                    : 'bg-slate-900 text-white hover:bg-rose-600'
                ]}
              >
                <span>View on Amazon</span>
                <span>→</span>
              </a>
            </div>
          </div>
        );
      })
    }
  </div>

  {
    verdictCallout && (
      <div class="border-t border-slate-100 bg-slate-50 px-6 py-3 text-xs leading-relaxed text-slate-600">
        <strong class="font-semibold text-slate-900">Buying Tip:</strong> {verdictCallout}
      </div>
    )
  }
</section>
